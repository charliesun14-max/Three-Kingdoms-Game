{
  "name": "three-kingdoms-rpg",
  "productName": "Mandate of Heaven",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --host 127.0.0.1",
    "predev": "node tools/copy-decoders.mjs",
    "prebuild": "node tools/copy-decoders.mjs",
    "desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "assets:optimize": "node tools/optimize-assets.mjs",
    "shots": "node tools/shoot.mjs",
    "assets:build": "node tools/assets/skin-textures.mjs && node tools/assets/build-assets.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charliesun14-max/Three-Kingdoms-Game.git"
  },
  "bugs": {
    "url": "https://github.com/charliesun14-max/Three-Kingdoms-Game/issues"
  },
  "homepage": "https://github.com/charliesun14-max/Three-Kingdoms-Game#readme",
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ma-shan-zheng": "^5.3.1",
    "@gltf-transform/cli": "^4.5.1",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "playwright": "^1.56.1",
    "three": "^0.170.0",
    "vite": "^5.4.21"
  },
  "type": "module",
  "private": true,
  "description": "Mandate of Heaven \u2014 an open-world Three Kingdoms RPG, from peasant to emperor.",
  "author": "Mandate of Heaven",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.mandateofheaven.game",
    "productName": "Mandate of Heaven",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "game"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.role-playing-games"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Game",
      "desktop": {
        "entry": {
          "StartupWMClass": "MandateOfHeaven"
        }
      },
      "executableName": "mandate-of-heaven"
    },
    "artifactName": "MandateOfHeaven-${version}-${os}-${arch}.${ext}",
    "executableName": "MandateOfHeaven"
  }
}
