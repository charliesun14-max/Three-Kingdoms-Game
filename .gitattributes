# Large art files are stored with Git LFS (https://git-lfs.com), which lifts GitHub's
# 100 MB per-file limit. Run `git lfs install` once; after that, adding these files works as usual.
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.ktx2 filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
public/assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
public/assets/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
public/assets/**/*.png filter=lfs diff=lfs merge=lfs -text
public/assets/**/*.webp filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.png filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.tga filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.tif filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.tiff filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.exr filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.webp filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.obj filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.mtl filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.usd filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.usdz filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.usdc filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.zip filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.7z filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.uasset filter=lfs diff=lfs merge=lfs -text

# Launchers keep the line endings their systems need
*.bat text eol=crlf
*.command text eol=lf
*.sh text eol=lf
