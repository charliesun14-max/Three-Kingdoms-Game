# Raw art downloads in assets-src/ are stored with Git LFS (https://git-lfs.com), which lifts
# GitHub's 100 MB per-file limit. Run `git lfs install` once; after that, adding files works as usual.
# Upper-case extensions are listed too: macOS matches these patterns case-insensitively, Linux does not.
# The optimised copies the game ships (public/assets/, built by npm run assets:build) are small and
# are kept as ordinary git files so every build machine and the game itself can use them directly.
assets-src/**/*.glb filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.gltf filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.bin filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.fbx filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.obj filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.mtl filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.blend filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.usd filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.usdz filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.usdc filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.ktx2 filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.hdr filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.exr filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.png filter=lfs diff=lfs merge=lfs -text
